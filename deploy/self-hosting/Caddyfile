# Echowire Caddyfile for the `edge` service (merge-upstream-2026-09-06).
# Upstream #2486 structure (trusted_proxies, per-route X-Forwarded-For, /_health, :8088
# -> /.well-known/fluxer) with fork retentions: the @marketing routes to marketing:3010
# and /fonts/* in @staticAssets. Site address stays :80 (HTTP; TLS terminates at Cloudflare).
{
	servers {
		trusted_proxies static {$FLUXER_EDGE_TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

{$FLUXER_EDGE_SITE_ADDRESS} {
	encode zstd gzip

	handle /_health {
		respond "OK" 200
	}

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle /gateway {
		rewrite * /
		reverse_proxy gateway:8080
	}

	handle_path /gateway/* {
		reverse_proxy gateway:8080
	}

	handle_path /media/* {
		reverse_proxy media-proxy:8080
	}

	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	handle /admin {
		rewrite * /
		reverse_proxy admin:8080
	}

	handle_path /admin/* {
		reverse_proxy admin:8080
	}

	@staticAssets path /fonts/* /web/* /emoji/* /libs/* /avatars/* /badges/* /desktop/* /embeds/*
	handle @staticAssets {
		reverse_proxy static-proxy:8080
	}

	# Echowire: keep the vendored rebranded marketing service (upstream #2486 dropped it).
	@marketing path /static/* /marketing/* /help /help/* /download /terms /privacy /guidelines /security /company-information /blog /blog/* /reverb /donate /donate/* /careers /careers/* /partners /press /press/* /en /en/*
	handle @marketing {
		reverse_proxy marketing:3010 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /.well-known/fluxer {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy app-proxy:8080
	}
}

:8088 {
	handle /.well-known/fluxer {
		reverse_proxy api:8080
	}
}
