# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=echowire
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=org.echowire.app %U
TryExec=org.echowire.app
Icon=org.echowire.app
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=org.echowire.app
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/fluxer;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=org.echowire.app --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=org.echowire.app --fluxer-task=new-dm %U
