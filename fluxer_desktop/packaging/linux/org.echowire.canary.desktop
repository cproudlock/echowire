# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=echowire canary
GenericName=Instant Messenger
Comment=Canary build of echowire
Exec=org.echowire.canary %U
TryExec=org.echowire.canary
Icon=org.echowire.canary
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=org.echowire.canary
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/fluxer;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=org.echowire.canary --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=org.echowire.canary --fluxer-task=new-dm %U
